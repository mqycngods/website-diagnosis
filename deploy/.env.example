# 命名前缀 — 与内部平台上的资源名保持一致
APP_NAME=plat-arch-site-diagnosis-zh

# 目标 namespace（留空则用 kubectl 当前 context 的默认 namespace）
NAMESPACE=

# Harbor 拉取凭证 Secret 名（集群里已存在同名 Secret 则保持不变）
IMAGE_PULL_SECRET=harbor-regcred

# 镜像地址与 tag —— 必须与本次 buildx --push 的 -t 参数完全一致
IMAGE_REPO=harbor.qihoo.net/commercial-platform-plat-arch/site-diagnosis-zh
IMAGE_TAG=20261117

---------------------------------------------------------------------
# 以下为注入容器的运行时环境变量（会被写进 Secret / ConfigMap）

# 业务 API Key —— 必须与 agent 平台工作流里配置的完全一致，
# 否则 /health 正常但所有 /collect 调用返回 401。
# 不要提交真实值到仓库；本地填在 deploy/.env（已被 .gitignore 忽略）。
SITE_DIAGNOSIS_API_KEY=change-me

# 抓取后端：curl（默认，指纹更接近真实浏览器，用于过 Cloudflare）
# 排查时可临时改 requests。镜像内已安装 curl。
GEO_HTTP_BACKEND=curl

# 服务监听端口（与 kubernetes.yaml 的 containerPort / 探针保持一致）
PORT=8000

# ── run_id 暂存后端（Redis）─────────────────────────────────────
# 配了 REDIS_PASSWORD 或 REDIS_URL 即可启用 redis 后端，
# 从而支持 replicas>1 与滚动更新。留空则回落 memory 后端（必须单副本）。
#
# 方式一：只填密码，脚本自动拼成
#   redis://:<密码>@<REDIS_HOST>:<REDIS_PORT>/0
REDIS_PASSWORD=
REDIS_HOST=plat-arch-site-diagnosis-redis
REDIS_PORT=6379

# 方式二：直接给完整 URL（优先级更高，填了就不用上面三项）
# REDIS_URL=redis://:password@redis-host:6379/0
REDIS_URL=

