# 命名前缀 — 与内部平台上的资源名保持一致
APP_NAME=plat-arch-site-diagnosis-zh

# 目标 namespace（留空则用 kubectl 当前 context 的默认 namespace）
NAMESPACE=

# Harbor 拉取凭证 Secret 名（集群里已存在同名 Secret 则保持不变）
IMAGE_PULL_SECRET=harbor-regcred

# 镜像地址与 tag —— 必须与本次 buildx --push 的 -t 参数完全一致
IMAGE_REPO=harbor.qihoo.net/commercial-platform-plat-arch/site-diagnosis-zh
IMAGE_TAG=20261117

---------------------------------------------------------------------
# 以下为注入容器的运行时环境变量（会被写进 Secret / ConfigMap）

# 业务 API Key —— 必须与 agent 平台工作流里配置的完全一致，
# 否则 /health 正常但所有 /collect 调用返回 401。
# 不要提交真实值到仓库；本地填在 deploy/.env（已被 .gitignore 忽略）。
SITE_DIAGNOSIS_API_KEY=change-me

# 抓取后端：curl（默认，指纹更接近真实浏览器，用于过 Cloudflare）
# 排查时可临时改 requests。镜像内已安装 curl。
GEO_HTTP_BACKEND=curl

# 服务监听端口（与 kubernetes.yaml 的 containerPort / 探针保持一致）
PORT=8000

# ── run_id 暂存后端（Redis）─────────────────────────────────────
# 配了 REDIS_PASSWORD 或 REDIS_URL 即可启用 redis 后端，
# 从而支持 replicas>1 与滚动更新。留空则回落 memory 后端（必须单副本）。
#
# 方式一：只填密码，脚本自动拼成
#   redis://:<密码>@<REDIS_HOST>:<REDIS_PORT>/0
REDIS_PASSWORD=
REDIS_HOST=plat-arch-site-diagnosis-redis
REDIS_PORT=6379

# 方式二：直接给完整 URL（优先级更高，填了就不用上面三项）
# REDIS_URL=redis://:password@redis-host:6379/0
REDIS_URL=

# ── 报告归档到 S3 兼容存储（可选）─────────────────────────────
# 不配齐 4 个 S3_* 必需变量时保持本地 results/ 落盘（Pod 重建会丢）；
# 配齐后 /render 改为上传到 S3，report_url 返回公开 URL（永久可归档），
# 上传成功后删除本地文件。详见 tools/s3_store.py。
#
# 必填（4 个，缺一即报错）：
# 上传用 endpoint —— 推荐内网地址（同机房零流量、低延迟），外部不可访问也没关系
#   阿里 OSS 内网: https://oss-cn-beijing-internal.aliyuncs.com
#   腾讯 COS:      https://cos.ap-beijing.myqcloud.com
#   MinIO 内网:    http://minio.internal:9000
#   AWS S3:        https://s3.cn-north-1.amazonaws.com.cn
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 可选：返回给调用方的 URL 前缀（CDN 域名 或 外网 endpoint，需 bucket 公有读）
# 不配则回退 presigned URL（默认 7 天过期，外部可访问）
# 阿里 OSS 公开读 + CDN: https://cdn.example.com
# 阿里 OSS 公开读:      https://oss-cn-beijing.aliyuncs.com
S3_PUBLIC_BASE_URL=

# 可选：URL 拼接风格，path（默认）或 virtual-host
# 阿里 OSS / 腾讯 COS / AWS 通常 virtual-host；MinIO / 又拍通常 path
# S3_PUBLIC_URL_STYLE=virtual-host

# 可选：region（AWS S3 与 R2 需要；阿里/腾讯/MinIO 一般不需要）
# S3_REGION=cn-north-1

# 可选：MinIO 等需要 path-style 寻址时设为 true
# S3_FORCE_PATH_STYLE=false

# 可选：S3 key 前缀（默认 reports）、presigned URL 有效期（秒，默认 604800 = 7 天）
# S3_KEY_PREFIX=reports
# S3_PRESIGNED_TTL_S=604800

