{"openapi":"3.1.0","info":{"title":"site-diagnosis-zh API","description":"中文官网 GEO 诊断工具集 — 供 agent 平台工作流调用","version":"1.0.0"},"paths":{"/collect":{"post":{"summary":"Collect","description":"一站式抓取：fetch_core + probe_bots + scan_pages。\n\n返回紧凑结构，平台按需取用：\n  {url, fetch, robots, technical, bots, citability, articles, pages, schema}\n\n若 articles.pending_agent_pick == true（动态站正则失效），\n平台 LLM 节点从 articles.internal_links 挑 URL 后调 /rescan 补抓。","operationId":"collect_collect_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CollectRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Response Collect Collect Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/rescan":{"post":{"summary":"Rescan","description":"动态站补抓：LLM 挑完 URL 后回传，重建 articles + schema。\n\n返回 {articles, schema}，替换 /collect 里对应字段后再走 /analyze。","operationId":"rescan_rescan_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RescanRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Response Rescan Rescan Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/analyze":{"post":{"summary":"Analyze","description":"纯计算：signals + analyzers + baseline_scores + brand。\n\n返回 {issues, signals_summary, baseline_scores, brand}。\nsignals_summary 是裁剪版（长文本截断到 200 字），供 LLM 评分用；\n完整 signals 不返回（太大且 LLM 不需要），/render 时用 summary 即可。","operationId":"analyze_analyze_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AnalyzeRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Response Analyze Analyze Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/render":{"post":{"summary":"Render","description":"渲染中文 HTML 报告（单文件，自包含）。\n\n直接把 /collect 与 /analyze 的输出、加上 LLM 写的 scores 打包传入。\nscores 可缺——缺了渲染器用确定性数据生成兜底发现。\n\n返回 text/html，平台可直接给用户下载或 iframe 展示。","operationId":"render_render_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RenderRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"text/html":{"schema":{"type":"string"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/health":{"get":{"summary":"Health","operationId":"health_health_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Response Health Health Get"}}}}}}}},"components":{"schemas":{"AnalyzeRequest":{"properties":{"url":{"type":"string","title":"Url","default":""},"fetch_page":{"additionalProperties":true,"type":"object","title":"Fetch Page"},"articles":{"additionalProperties":true,"type":"object","title":"Articles"},"pages_audit":{"additionalProperties":true,"type":"object","title":"Pages Audit"},"schema":{"additionalProperties":true,"type":"object","title":"Schema"},"citability":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"title":"Citability"},"bots":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"title":"Bots"},"technical":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"title":"Technical"}},"type":"object","required":["fetch_page","articles","pages_audit","schema"],"title":"AnalyzeRequest","description":"把 /collect 的三段结果原样回传，零网络纯计算。"},"CollectRequest":{"properties":{"url":{"type":"string","title":"Url"}},"type":"object","required":["url"],"title":"CollectRequest"},"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"RenderRequest":{"properties":{"domain":{"type":"string","title":"Domain"},"url":{"type":"string","title":"Url"},"audit_date":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Audit Date"},"fetch":{"additionalProperties":true,"type":"object","title":"Fetch","default":{}},"robots":{"additionalProperties":true,"type":"object","title":"Robots","default":{}},"bots":{"additionalProperties":true,"type":"object","title":"Bots","default":{}},"citability":{"additionalProperties":true,"type":"object","title":"Citability","default":{}},"schema":{"additionalProperties":true,"type":"object","title":"Schema","default":{}},"articles":{"additionalProperties":true,"type":"object","title":"Articles","default":{}},"technical":{"additionalProperties":true,"type":"object","title":"Technical","default":{}},"brand":{"additionalProperties":true,"type":"object","title":"Brand","default":{}},"issues":{"additionalProperties":true,"type":"object","title":"Issues","default":{}},"signals_summary":{"additionalProperties":true,"type":"object","title":"Signals Summary","default":{}},"scores":{"additionalProperties":true,"type":"object","title":"Scores","default":{}},"offline":{"type":"boolean","title":"Offline","default":false}},"type":"object","required":["domain","url"],"title":"RenderRequest","description":"LLM 写完 scores 后，把所有中间数据打包传给 render。"},"RescanRequest":{"properties":{"agent_picks":{"additionalProperties":true,"type":"object","title":"Agent Picks"},"fetch_page":{"additionalProperties":true,"type":"object","title":"Fetch Page"}},"type":"object","required":["agent_picks","fetch_page"],"title":"RescanRequest","description":"pending_agent_pick 分支：LLM 挑完 URL 后回传补抓。"},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"},"input":{"title":"Input"},"ctx":{"type":"object","title":"Context"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"}}}}