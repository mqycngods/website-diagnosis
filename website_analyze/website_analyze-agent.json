{
  "project_id": 7,
  "agent": {
    "agent_key": "website_analyze",
    "agent_name": "官网诊断",
    "visibility": 0,
    "agent_type": 0,
    "agent_type_label": "任务型",
    "model_key": "deepseek/deepseek-v4.1-flash",
    "system_prompt_ref": "./website_analyze-agent.md",
    "input_schema": [
      {
        "type": "string",
        "field": "url",
        "required": true,
        "description": "官网"
      }
    ],
    "output_schema": [
      {
        "type": "string",
        "field": "result",
        "required": true,
        "description": "输出结果（GEO 优化执行清单的 Markdown 全文）"
      },
      {
        "type": "string",
        "field": "html_url",
        "required": true,
        "description": "在线 HTML 报告链接（取 site_render 返回的 report_url）"
      },
      {
        "type": "string",
        "field": "md_url",
        "required": true,
        "description": "执行清单 Markdown 在线链接（取 site_render 返回的 md_url）"
      },
      {
        "type": "string",
        "field": "html_result",
        "required": true,
        "description": "报告 HTML 全文（逐字复制 site_render 返回的 html 字段，通常数万字符；禁止占位/摘要/截断；输出时放最后一个字段）"
      }
    ],
    "temperature": 0.7,
    "max_retries": 3,
    "timeout_seconds": 1200,
    "skill_refs": [
      "website_audit",
      "execution_plan"
    ],
    "tool_refs": [
      "diagnose_run",
      "site_rescan",
      "site_analyze",
      "site_render"
    ],
    "options": null,
    "callbacks": null
  },
  "skills": [
    {
      "skill_name": "官网诊断LLM",
      "skill_name_en": "website_audit",
      "description": "为站点写中文五维评分、findings 与行动方案",
      "skill_prompt_ref": "./skill_resource/website_audit_prompt.md"
    },
    {
      "skill_name": "GEO 执行计划",
      "skill_name_en": "execution_plan",
      "description": "把诊断发现拆成 8-14 项可独立勾选验收的 GEO 优化执行清单",
      "skill_prompt_ref": "./skill_resource/execution_plan_prompt.md"
    }
  ],
  "tools": [
    {
      "tool_name": "GEO 官网确定性采集",
      "tool_name_en": "diagnose_run",
      "description": "对目标 URL 做确定性采集：首页抓取、robots.txt、12 个 AI 爬虫 UA 重放、可引用性评分、Schema 检测、品牌实体、安全头、功能页发现、信号提取、规则引擎。",
      "tool_type": 1,
      "input_params": [
        {
          "type": "string",
          "field": "url",
          "required": false,
          "description": "诊断官网"
        }
      ],
      "url_config": {
        "url": "https://website-diagnosis-amhp.onrender.com/api/collect",
        "body": "{\"url\": \"{{url}}\"}",
        "method": "POST",
        "params": {},
        "headers": {
          "X-API-Key": "dg2fjgthISORePJ3cYtiws9RcCvsGlyEWLshikBr1gc",
          "Content-Type": "application/json"
        },
        "timeout": 120,
        "auth_type": "none",
        "body_type": "raw",
        "auth_config": {}
      }
    },
    {
      "tool_name": "动态站补抓",
      "tool_name_en": "site_rescan",
      "description": "动态站补抓（仅 articles.pending_agent_pick == true 时调用）",
      "tool_type": 1,
      "input_params": [
        {
          "type": "string",
          "field": "run_id",
          "required": true,
          "description": "diagnose_run 返回的 run_id（采集数据已暂存服务端）"
        },
        {
          "type": "string",
          "field": "articles",
          "required": true,
          "description": "文章 URL 列表（JSON 数组字符串）"
        },
        {
          "type": "string",
          "field": "products",
          "required": true,
          "description": "产品 URL 列表（JSON 数组字符串）"
        }
      ],
      "url_config": {
        "url": "https://website-diagnosis-amhp.onrender.com/api/rescan",
        "body": "{\n  \"run_id\": \"{{run_id}}\",\n  \"agent_picks\": {\n    \"articles\": {{articles}},\n    \"products\": {{products}}\n  }\n}",
        "method": "POST",
        "params": {},
        "headers": {
          "X-API-Key": "dg2fjgthISORePJ3cYtiws9RcCvsGlyEWLshikBr1gc",
          "Content-Type": "application/json"
        },
        "timeout": 120,
        "auth_type": "none",
        "body_type": "raw",
        "auth_config": {}
      }
    },
    {
      "tool_name": "信号分析",
      "tool_name_en": "site_analyze",
      "description": "零网络纯计算：signals 提取 + checks 规则引擎 + 品牌实体 + 确定性基线分",
      "tool_type": 1,
      "input_params": [
        {
          "type": "string",
          "field": "run_id",
          "required": true,
          "description": "diagnose_run 返回的 run_id（采集数据已暂存服务端）"
        },
        {
          "type": "string",
          "field": "url",
          "required": true,
          "description": "站点 URL"
        }
      ],
      "url_config": {
        "url": "https://website-diagnosis-amhp.onrender.com/api/analyze",
        "body": "{\n  \"run_id\": \"{{run_id}}\",\n  \"url\": \"{{url}}\"\n}",
        "method": "POST",
        "params": {},
        "headers": {
          "X-API-Key": "dg2fjgthISORePJ3cYtiws9RcCvsGlyEWLshikBr1gc",
          "Content-Type": "application/json"
        },
        "timeout": 120,
        "auth_type": "none",
        "body_type": "raw",
        "auth_config": {}
      }
    },
    {
      "tool_name": "渲染报告",
      "tool_name_en": "site_render",
      "description": "渲染中文 HTML 诊断报告并落盘服务端 results/，返回 report_url（在线报告）、html（报告 HTML 全文）与 md_url（执行清单 Markdown 在线链接）；scores 可缺省，缺省走确定性兜底；plan_md 为执行清单 Markdown 字符串，传了则 md_url 指向清单。**调用约定：scores / plan_md 一律以 Base64 传，encoding=base64**——服务端前有边缘 WAF，明文正文含目录穿越特征串时会被 403 拦截（响应为 text/html 拦截页而非 JSON）",
      "tool_type": 1,
      "input_params": [
        {
          "type": "string",
          "field": "run_id",
          "required": true,
          "description": "diagnose_run 返回的 run_id（采集与分析数据已暂存服务端）"
        },
        {
          "type": "string",
          "field": "url",
          "required": true,
          "description": "用户输入的站点 URL（run_id 暂存过期时兜底用，必带）"
        },
        {
          "type": "string",
          "field": "scores",
          "required": true,
          "description": "评分对象的 JSON 字符串（必须 json.dumps 序列化为字符串，不要传对象本身；无则传 \"{}\"）。**默认一律先传该字符串的 Base64(utf-8)**，并把 encoding 设为 base64——服务端前有边缘 WAF，正文含目录穿越串时明文请求会被 403 拦掉；仅当服务端返回「无法解析」时才回落明文重试"
        },
        {
          "type": "string",
          "field": "plan_md",
          "required": true,
          "description": "GEO 执行清单 Markdown 的 JSON 字符串（必须 json.dumps 序列化为字符串，不要传裸文本本身）。**默认一律先传该字符串的 Base64(utf-8)**，与 scores 一致；回落明文时两者都要同时改回明文"
        },
        {
          "type": "string",
          "field": "encoding",
          "required": true,
          "description": "**必须填 base64**。服务端据此把 scores / plan_md 按 Base64(utf-8) 解码后再用。不能留空：服务端前面有 Render 边缘 WAF，会检测请求体正文，明文里出现目录穿越特征串（如 ../../etc/passwd）时请求会在到达服务前被拦，返回 HTTP 403 + HTML 拦截页"
        }
      ],
      "url_config": {
        "url": "https://website-diagnosis-amhp.onrender.com/api/render",
        "body": "{\n  \"run_id\": \"{{run_id}}\",\n  \"url\": \"{{url}}\",\n  \"scores\": \"{{scores}}\",\n  \"plan_md\": \"{{plan_md}}\",\n  \"encoding\": \"{{encoding}}\"\n}",
        "method": "POST",
        "params": {},
        "headers": {
          "X-API-Key": "dg2fjgthISORePJ3cYtiws9RcCvsGlyEWLshikBr1gc",
          "Content-Type": "application/json"
        },
        "timeout": 120,
        "auth_type": "none",
        "body_type": "raw",
        "auth_config": {}
      }
    }
  ]
}